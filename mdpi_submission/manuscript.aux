\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Qualitative failure mode analysis for four representative DeepCrack test images. The cases were selected by predefined diagnostic criteria: text over-segmentation, point local-recovery failure, AMPF false-negative suppression, and mean-fusion complementary recovery. Columns show the original image, ground truth, text prompt, box prompt, point prompt, AMPF, and mean fusion. AMPF and Mean Fusion use GT-assisted alignment and are shown only as diagnostic protocols.}}{12}{figure.caption.4}\protected@file@percent }
\newlabel{fig:4}{{4}{12}{Qualitative failure mode analysis for four representative DeepCrack test images. The cases were selected by predefined diagnostic criteria: text over-segmentation, point local-recovery failure, AMPF false-negative suppression, and mean-fusion complementary recovery. Columns show the original image, ground truth, text prompt, box prompt, point prompt, AMPF, and mean fusion. AMPF and Mean Fusion use GT-assisted alignment and are shown only as diagnostic protocols}{figure.caption.4}{}}
\newlabel{fig:4@cref}{{[figure][4][]4}{[1][12][]12}{}{}{}}
